# This file sets board specific default parameters.
. /lib/ipq.sh


enable_rps() {
		board_name=$(ipq_board_name)
		echo $board_name
		num_core=3

		#Enable 4-core RPS for all IPQ9574 boards that do not support WiFi7 radio
		if [ "$board_name" = "qcom,ipq9574-ap-al01-c1" ]; then
			num_core=4
		fi

		if [ "$board_name" = "qcom,ipq9574-ap-al02-c1" ]; then
			num_core=4
		fi

		if [ "$board_name" = "qcom,ipq9574-ap-al02-c2" ]; then
			num_core=4
		fi

		if [ "$board_name" = "qcom,ipq9574-ap-al02-c3" ]; then
			num_core=4
		fi

		i=1
		irq_rps=`grep edma_rxdesc /proc/interrupts | cut -d ':' -f 1 | tr -d ' '`
		for entry in $irq_rps
		do
			echo $i > /proc/irq/$entry/smp_affinity
			i=$(expr $i \* 2)
			if [ $i -gt 8 ];then
				i=1
			fi
		done

		i=1
		irq_rps=`grep edma_txcmpl /proc/interrupts | cut -d ':' -f 1 | tr -d ' '`
		for entry in $irq_rps
		do
			echo $i > /proc/irq/$entry/smp_affinity
			i=$(expr $i \* 2)
			if [ $i -gt 8 ];then
				i=1
			fi
		done

		#Enable RPS to use only 3 cores by default
		echo $num_core > /proc/sys/net/edma/rps_num_cores
}

start() {
	local rps_enabled=$(syscfg get enable_rps)
	if [ "$rps_enabled" -eq 1 ]; then
		enable_rps
		echo "rps enabled"
	fi
}

case "$1" in
    start)
	start
	;;
    *)
	echo "Unsupported operation: available operations (start )"
esac
